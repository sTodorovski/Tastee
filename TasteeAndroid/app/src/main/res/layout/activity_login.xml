<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".LoginActivity"
    android:background="@drawable/background_repeat">

    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/guideline"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        app:layout_constraintGuide_percent="0.5"/>

    <com.example.tastee.SimpleWaveView
        android:id="@+id/wave"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:transitionName="wave_shared"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.0"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@id/guideline"
        app:layout_constraintVertical_bias="0.0" />

    <TextView
        android:id="@+id/tasteeTextView"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="@font/sora_light"
        android:text="Tastee"
        android:textColor="@color/white"
        android:textSize="65dp"
        app:layout_constraintBottom_toBottomOf="@+id/wave"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.497"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/guideline"
        app:layout_constraintVertical_bias="0.200" />

    <EditText
        android:id="@+id/usernameInput"
        android:layout_width="331dp"
        android:layout_height="48dp"
        android:backgroundTint="#80FFFFFF"
        android:ems="10"
        android:hint="Username"
        android:inputType="text"
        android:textColor="@color/white"
        android:textColorHint="#80FFFFFF"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="@+id/wave"
        app:layout_constraintTop_toBottomOf="@+id/tasteeTextView"
        app:layout_constraintVertical_bias="0.042" />

    <EditText
        android:id="@+id/passwordInput"
        android:layout_width="328dp"
        android:layout_height="48dp"
        android:backgroundTint="#80FFFFFF"
        android:ems="10"
        android:hint="Password"
        android:inputType="textPassword"
        android:textColorHint="#80FFFFFF"
        android:textColor="@color/white"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.481"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/usernameInput"
        app:layout_constraintVertical_bias="0.067" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/logInButton"
        android:text="Log In"
        android:layout_width="335dp"
        android:layout_height="54dp"
        android:textColor="@android:color/white"
        android:backgroundTint="@android:color/transparent"
        app:strokeColor="@color/white"
        app:strokeWidth="1dp"
        android:textSize="20dp"
        android:layout_marginTop="25dp"
        app:layout_constraintVertical_chainStyle="spread"
        app:cornerRadius="24dp"
        app:layout_constraintTop_toBottomOf="@id/passwordInput"
        app:layout_constraintBottom_toTopOf="@id/registerButton"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/registerButton"
        android:text="Register as a customer"
        android:layout_width="335dp"
        android:layout_height="54dp"
        android:textColor="@android:color/white"
        android:backgroundTint="@android:color/transparent"
        app:strokeColor="@color/white"
        app:strokeWidth="1dp"
        android:textSize="20dp"
        app:cornerRadius="24dp"
        android:layout_marginTop="8dp"
        app:layout_constraintTop_toBottomOf="@id/logInButton"
        app:layout_constraintBottom_toTopOf="@id/registerDeliveryButton"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/registerDeliveryButton"
        android:layout_width="335dp"
        android:layout_height="54dp"
        android:textColor="@android:color/white"
        android:backgroundTint="@android:color/transparent"
        app:strokeColor="@color/white"
        app:strokeWidth="1dp"
        android:textSize="20dp"
        app:cornerRadius="24dp"
        android:layout_marginTop="8dp"
        android:text="Register as a delivery driver"
        app:layout_constraintTop_toBottomOf="@id/registerButton"
        app:layout_constraintBottom_toTopOf="@id/registerBusinessButton"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/registerBusinessButton"
        android:layout_width="335dp"
        android:layout_height="54dp"
        android:textColor="@android:color/white"
        android:backgroundTint="@android:color/transparent"
        app:strokeColor="@color/white"
        app:strokeWidth="1dp"
        android:textSize="20dp"
        app:cornerRadius="24dp"
        android:text="Register a business"
        android:layout_marginTop="8dp"
        app:layout_constraintTop_toBottomOf="@id/registerDeliveryButton"
        app:layout_constraintBottom_toTopOf="@id/socialMediaLayout"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <LinearLayout
        android:id="@+id/socialMediaLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="16dp"
        android:gravity="center"
        android:orientation="horizontal"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.0"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/registerBusinessButton"
        app:layout_constraintVertical_bias="0.25">

        <com.google.android.material.imageview.ShapeableImageView
            android:id="@+id/facebookButton"
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:layout_margin="16dp"
            android:src="@drawable/facebook" />

        <com.google.android.material.imageview.ShapeableImageView
            android:id="@+id/googleButton"
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:layout_margin="16dp"
            android:src="@drawable/google" />

        <com.google.android.material.imageview.ShapeableImageView
            android:id="@+id/emailButton"
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:layout_margin="16dp"
            android:src="@drawable/email"
            app:shapeAppearanceOverlay="@style/CircleImage" />
    </LinearLayout>

    <View
        android:id="@+id/bottomCover"
        android:layout_width="0dp"
        android:layout_height="24dp"
        android:background="@color/black"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>