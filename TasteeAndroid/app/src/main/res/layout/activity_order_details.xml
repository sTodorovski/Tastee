<?xml version="1.0" encoding="utf-8"?>

<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:background="@color/black"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Order Details"
            android:textColor="@color/white"
            android:textStyle="bold"
            android:textSize="30sp"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Delivery Address"
            android:textColor="@color/white"
            android:textStyle="bold"
            android:layout_marginTop="25dp"/>

        <EditText
            android:id="@+id/addressEditText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/white"
            android:textColorHint="@android:color/darker_gray"
            android:hint="Enter delivery address"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Delivery Type"
            android:textStyle="bold"
            android:textColor="@color/white"
            android:layout_marginTop="25dp"/>

        <RadioGroup
            android:id="@+id/deliveryGroup"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <RadioButton
                android:id="@+id/pickUp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Pick Up In Restaurant (Free)"
                android:textColor="@color/white"
                android:checked="true"/>

            <RadioButton
                android:id="@+id/standardDelivery"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/white"
                android:text="Standard Delivery (Free)"/>

            <RadioButton
                android:id="@+id/expressDelivery"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/white"
                android:text="Express Delivery (+$4.99)"/>

        </RadioGroup>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Tip"
            android:textStyle="bold"
            android:textColor="@color/white"
            android:layout_marginTop="15dp"/>

        <com.google.android.material.chip.ChipGroup
            android:id="@+id/tipGroup"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:singleSelection="true"
            app:selectionRequired="true">

            <com.google.android.material.chip.Chip
                android:id="@+id/noTip"
                style="@style/Widget.Material3.Chip.Assist"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="None"
                android:backgroundTint="@color/darkgrey"
                android:textColor="@color/white"
                android:checkable="true"
                android:checked="true"/>

            <com.google.android.material.chip.Chip
                android:id="@+id/tip2"
                style="@style/Widget.Material3.Chip.Assist"
                android:layout_width="wrap_content"
                android:textColor="@color/white"
                android:layout_height="wrap_content"
                android:backgroundTint="@color/darkgrey"
                android:text="$2.5"
                android:checkable="true"/>

            <com.google.android.material.chip.Chip
                android:id="@+id/tip5"
                style="@style/Widget.Material3.Chip.Assist"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:backgroundTint="@color/darkgrey"
                android:textColor="@color/white"
                android:text="$5"
                android:checkable="true"/>

            <com.google.android.material.chip.Chip
                android:id="@+id/tip10"
                style="@style/Widget.Material3.Chip.Assist"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:backgroundTint="@color/darkgrey"
                android:text="$10"
                android:textColor="@color/white"
                android:checkable="true"/>

            <com.google.android.material.chip.Chip
                android:id="@+id/customTip"
                style="@style/Widget.Material3.Chip.Assist"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:backgroundTint="@color/darkgrey"
                android:text="Custom"
                android:textColor="@color/white"
                android:checkable="true"/>

        </com.google.android.material.chip.ChipGroup>

        <EditText
            android:id="@+id/customTipAmount"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Custom tip"
            android:inputType="numberDecimal"
            android:textColorHint="@android:color/darker_gray"
            android:textColor="@color/white"
            android:visibility="gone"/>

        <EditText
            android:id="@+id/requestsEditText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="15dp"
            android:hint="Special requests (optional)"
            android:inputType="textCapSentences|textMultiLine"
            android:textColorHint="@android:color/darker_gray"
            android:textColor="@color/white"
            android:gravity="top|start"
            android:minLines="3"
            android:maxLines="5" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Summary"
            android:textStyle="bold"
            android:textColor="@color/white"
            android:textSize="22sp"
            android:layout_marginTop="15dp"/>

        <TextView
            android:id="@+id/subtotalText"
            android:layout_width="match_parent"
            android:textColor="@color/white"
            android:layout_height="wrap_content"/>

        <TextView
            android:id="@+id/deliveryText"
            android:layout_width="match_parent"
            android:textColor="@color/white"
            android:layout_height="wrap_content"/>

        <TextView
            android:id="@+id/tipText"
            android:layout_width="match_parent"
            android:textColor="@color/white"
            android:layout_height="wrap_content"/>

        <TextView
            android:id="@+id/totalText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textStyle="bold"
            android:textColor="@color/white"
            android:textSize="22sp"
            android:layout_marginTop="10dp"/>

        <Button
            android:id="@+id/cashButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:backgroundTint="@color/darkgrey"
            android:textColor="@color/white"
            android:text="Pay With Cash"
            android:layout_marginTop="15dp"/>

        <Button
            android:id="@+id/paymentButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Continue to Payment"
            android:backgroundTint="@color/darkgrey"
            android:textColor="@color/white"
            android:layout_marginTop="10dp"/>

    </LinearLayout>

</ScrollView>